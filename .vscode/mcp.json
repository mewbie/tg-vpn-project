{
  "inputs": [
    {
      "type": "promptString",
      "id": "venice-key",
      "description": "Venice API key",
      "password": true
    }
  ],
  "servers": {
    "venice": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@veniceai/mcp-server@0.3.0"],
      "env": { "VENICE_API_KEY": "${input:venice-key}" }
    }
  }
}